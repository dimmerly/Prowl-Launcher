<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION.txt').Trim())</Version>
    <AssemblyName>Prowl.Launcher</AssemblyName>
    <Product>Prowl Launcher</Product>
    <Title>Prowl Launcher</Title>
    <Description>The Prowl launcher.</Description>
    <ApplicationIcon>Resources/prowl.ico</ApplicationIcon>
    <SampleCatalogFile Condition="'$(SampleCatalogFile)' == ''">$(MSBuildProjectDirectory)/Resources/Samples/catalog.json</SampleCatalogFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Prowl.Launcher.Test"/>
    <AssemblyMetadata Include="SelfInstall" Value="$(SelfInstall)"/>
    <AssemblyMetadata Include="DevelopmentNewsDirectory" Value="$(MSBuildProjectDirectory)/../news" Condition="'$(Configuration)' == 'Debug'"/>
    <PackageReference Include="OpenTK" Version="4.9.4"/>
    <PackageReference Include="Prowl.Paper" Version="$(ProwlPackageVersion)"/>
    <PackageReference Include="Prowl.Origami" Version="$(ProwlPackageVersion)"/>
    <PackageReference Include="Prowl.Rosetta" Version="$(ProwlPackageVersion)"/>
    <PackageReference Include="Prowl.Aperture" Version="$(ProwlPackageVersion)"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/*.ttf"/>
    <EmbeddedResource Include="Resources/prowl.png" LogicalName="Prowl.Launcher.prowl.png"/>
    <EmbeddedResource Include="Resources/Locale/*.json" LogicalName="Prowl.Launcher.Locale.%(Filename).json"/>
    <EmbeddedResource Include="Resources/Icons/*.svg" LogicalName="Prowl.Launcher.Icons.%(Filename).svg"/>
    <EmbeddedResource Include="Resources/Samples/*.png" LogicalName="Prowl.Launcher.Samples.%(Filename).png"/>
    <EmbeddedResource Include="$(SampleCatalogFile)" LogicalName="Prowl.Launcher.Samples.catalog.json"/>
  </ItemGroup>
</Project>
